NODE_ENV=development
PORT=8080

# Use DATABASE_URL or POSTGRES_URL in production. The individual values are
# convenient for the local Docker Postgres service.
DATABASE_URL=
POSTGRES_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fitx
POSTGRES_POOL_MAX=5

BCRYPT_SALT_ROUNDS=10
JWT_SECRET=replace-with-a-long-random-secret

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MEMORY_MODEL=gpt-4.1-nano
OPENAI_AGENTS_TRACING_ENABLED=false
